{
  "name": "solidmagnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A SolidJS port of the bitmagnet web UI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@fontsource/roboto": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.1",
    "@solidjs/web": "^2.0.3",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "filesize": "^10.1.6",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript": "^6.0.0",
    "@graphql-codegen/typescript-operations": "^6.0.0",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.0.0",
    "eslint-plugin-solid": "^0.20.1",
    "filesystem-routing": "^0.5.0",
    "graphql": "^17.1.0",
    "jsdom": "^27.0.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
